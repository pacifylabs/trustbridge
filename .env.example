# ---------------------------------------------------------------------------
# TrustBridge Immigration Services Ltd: environment configuration
# Copy to `.env.local` for development and fill in the values.
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://trustbridgeimmigration.co.uk

# Which environment this deployment represents: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------------------
# Deploying
# ---------------------------------------------------------------------------
# Nothing here is required for a build to succeed. Every variable has a safe
# default, and a blank value is treated the same as an unset one, so a host
# that exposes declared-but-empty variables will not fail the build.
#
# The defaults are deliberately closed: a production build that is told nothing
# assumes it is production and serves the Coming Soon page. To publish the full
# site you have to say so explicitly, below.
#
# NEXT_PUBLIC_* values are baked in when the site is built, so changing one
# needs a fresh deployment, not just a restart. On Vercel, saving a variable
# triggers that automatically.
#
# ---------------------------------------------------------------------------
# Launch gate
# ---------------------------------------------------------------------------
# false → production serves the Coming Soon page only.
# Development and staging always serve the full site.
# Do not set this to true until the client has given explicit launch approval.
SITE_LAUNCHED=false

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Complex Immigration Matters: the route returns 404 and is excluded from the
# navigation, the services index, the sitemap and structured data while false.
FEATURE_COMPLEX_MATTERS=false

# Business Immigration: the category page remains available, but the
# route-specific detail sections are hidden while false.
FEATURE_BUSINESS_IMMIGRATION=false

# Allows staging reviewers to preview flag-gated sections via a signed cookie.
# Leave empty in production.
PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Content
# ---------------------------------------------------------------------------
# There is no CMS and no database. Articles, services and adviser profiles
# are edited as code in src/content and published through the normal deploy
# process.

# ---------------------------------------------------------------------------
# Enquiry email delivery (Resend)
# ---------------------------------------------------------------------------
# There is no database: a submission is validated and emailed straight to the
# shared inbox, nothing else. Without RESEND_API_KEY the form still renders
# and validates, but sending fails and the visitor is told to email or call
# directly instead.
#
# ENQUIRY_FROM_EMAIL must be on a domain verified in the Resend dashboard
# before Resend will send from it.
ENQUIRY_INBOX=info@trustbridgeimmigration.co.uk
ENQUIRY_FROM_EMAIL=enquiries@trustbridgeimmigration.co.uk
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Google reCAPTCHA v2 (checkbox)
# ---------------------------------------------------------------------------
# Both keys come from registering the site at google.com/recaptcha/admin.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY is public and shipped to the browser; without
# it the widget does not render and the enquiry form skips reCAPTCHA
# validation entirely, so both keys should be set together.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Calendly booking (/book)
# ---------------------------------------------------------------------------
# The event type's public scheduling URL, e.g.
# https://calendly.com/trustbridge/consultation. Left unset, the /book page
# falls back to an "email or call us" placeholder instead of a broken widget.
# The visitor still has to click "Show available times" before the widget
# (and Calendly's own cookies) load, so this alone does not need a
# cookie-consent banner.
NEXT_PUBLIC_CALENDLY_URL=
